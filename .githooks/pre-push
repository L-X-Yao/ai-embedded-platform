#!/bin/bash
# pre-push hook — local CI gate before every push.
#
# Install: make install-hooks   (or: git config core.hooksPath .githooks)
#
# Checks:
#   1. Block force-push to main/master
#   2. Run `make ci-local` — tests + audit + scaffold + doc-drift
#
# Skip: git push --no-verify

REPO="$(cd "$(dirname "$0")/.." && pwd)"

# ── Force-push guard ─────────────────────────────────────────────────
PROTECTED_BRANCHES="main|master"
while IFS= read -r line; do
    local_ref=$(echo "$line" | awk '{print $1}')
    local_sha=$(echo "$line" | awk '{print $2}')
    remote_ref=$(echo "$line" | awk '{print $3}')
    remote_sha=$(echo "$line" | awk '{print $4}')
    branch=$(basename "$remote_ref")
    zero_sha="0000000000000000000000000000000000000000"

    if echo "$branch" | grep -qE "^($PROTECTED_BRANCHES)$"; then
        if [[ "$remote_sha" != "$zero_sha" ]]; then
            if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
                echo "ERROR: force-push to '$branch' is not allowed."
                echo "  Remote: $remote_sha"
                echo "  Local:  $local_sha"
                echo ""
                echo "  If intentional: git push --no-verify"
                exit 1
            fi
        fi
    fi
done

# ── Local CI gate ────────────────────────────────────────────────────
echo "pre-push: running ci-local..."
if make -C "$REPO" ci-local 2>&1; then
    echo "pre-push: ci-local PASSED"
    exit 0
else
    echo ""
    echo "pre-push: ci-local FAILED — fix before pushing"
    echo "  To skip: git push --no-verify"
    exit 1
fi

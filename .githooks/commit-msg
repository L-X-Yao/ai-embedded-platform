#!/bin/bash
# commit-msg hook — validates commit message against CLAUDE.md convention.
#
# Install: git config core.hooksPath .githooks
#
# Checks:
#   1. First line matches <type>(<scope>): <summary> or <type>: <summary>
#   2. Type is from the allowed set
#   3. Summary starts with lowercase verb, no trailing period
#   4. No Co-Authored-By line (project convention)
#   5. Summary line <= 70 chars
#   6. Summary must be ASCII only (no Chinese/mixed text)
#   7. Body lines > 72 chars (warning only, not blocking)

MSG_FILE="$1"
MSG=$(head -1 "$MSG_FILE")

TYPES="docs|wheel|exp|port|project|tool|ci"
PATTERN="^($TYPES)(\([a-z0-9/_-]+\))?: [a-z]"

if ! echo "$MSG" | grep -qE "$PATTERN"; then
    echo "ERROR: commit message does not match convention."
    echo ""
    echo "  Expected: <type>(<scope>): <lowercase verb> ..."
    echo "  Got:      $MSG"
    echo ""
    echo "  Allowed types: $TYPES"
    echo "  See CLAUDE.md 'Commit 规范' section."
    exit 1
fi

if echo "$MSG" | grep -qE '\.$'; then
    echo "ERROR: summary must not end with a period."
    echo "  Got: $MSG"
    exit 1
fi

if [ ${#MSG} -gt 70 ]; then
    echo "ERROR: summary line too long (${#MSG} > 70 chars)."
    echo "  Got: $MSG"
    exit 1
fi

if grep -qi "Co-Authored-By" "$MSG_FILE"; then
    echo "ERROR: Co-Authored-By is not used in this project (see CLAUDE.md)."
    exit 1
fi

if echo "$MSG" | LC_ALL=C grep -q '[^ -~]'; then
    echo "ERROR: summary must be English only (no Chinese or non-ASCII characters)."
    echo "  Got: $MSG"
    exit 1
fi

# Check body lines (skip first line and blank separator) for <= 72 chars
LINE_NUM=0
while IFS= read -r LINE; do
    LINE_NUM=$((LINE_NUM + 1))
    if [ $LINE_NUM -le 2 ]; then
        continue
    fi
    if [ ${#LINE} -gt 72 ]; then
        echo "WARNING: body line $LINE_NUM exceeds 72 chars (${#LINE})."
        echo "  Line: $LINE"
    fi
done < "$MSG_FILE"

exit 0
